# ==============================================================================
# AVITO MAX PARSER & AI DEAL SCORING ENGINE — CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. СЕТЬ И ВЕБ-СЕРВЕР (FASTAPI / UVICORN)
# ------------------------------------------------------------------------------
# Хост для привязки сервера (0.0.0.0 для внешнего доступа на сервере, 127.0.0.1 для локального)
WEB_HOST=0.0.0.0
# Порт веб-интерфейса
WEB_PORT=8000

# ------------------------------------------------------------------------------
# 2. ТЕЛЕГРАМ БОТ & УВЕДОМЛЕНИЯ
# ------------------------------------------------------------------------------
# Токен бота (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=8724200989:AAHBunxkdoCny3fwj1XdB6Lds7jRr_8pTus
# Telegram ID администраторов через запятую (узнайте ID через @userinfobot)
TELEGRAM_ADMIN_IDS=123456789,987654321
# Интервал фонового опроса задач мониторинга (в минутах)
NOTIFICATION_INTERVAL_MIN=2

# ------------------------------------------------------------------------------
# 3. ДВИЖОК БРАУЗЕРА (PLAYWRIGHT / CHROMIUM)
# ------------------------------------------------------------------------------
# True = фоновый режим без GUI (обязательно для Ubuntu Server / VPS)
# False = видимое окно Chromium (удобно для Windows Desktop при отладке)
SCRAPER_HEADLESS=true
# Таймаут загрузки страниц в миллисекундах
SCRAPER_TIMEOUT_MS=45000
# Случайная задержка между запросами (в секундах) для защиты от блокировок
SCRAPER_PAGE_DELAY_MIN=2.0
SCRAPER_PAGE_DELAY_MAX=5.0

# ------------------------------------------------------------------------------
# 4. ПРОКСИ-СЕРВЕРЫ
# ------------------------------------------------------------------------------
# Использовать ли прокси по умолчанию (true / false)
PROXY_ENABLED=false
# Основной прокси (HTTP / SOCKS5)
# Примеры форматов:
#   http://user:password@ip:port
#   socks5://user:password@ip:port
#   ip:port:user:password
DEFAULT_PROXY=

# ------------------------------------------------------------------------------
# 5. ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ (AI DEAL SCORING / LLM SUMMARY)
# ------------------------------------------------------------------------------
# Провайдер нейросети: deepseek | openrouter | openai | ollama
AI_PROVIDER=deepseek
# API-ключ выбранного провайдера
AI_API_KEY=
# Модель для анализа объявлений
AI_MODEL=deepseek-chat
# Базовый URL API (для DeepSeek: https://api.deepseek.com, для локальной Ollama: http://localhost:11434/v1)
AI_API_BASE=https://api.deepseek.com
